# =========================================
# Arthsaathi Frontend (Next.js) .gitignore
# =========================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/

# Environment Configurations & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Testing & Coverage
coverage/
.nyc_output/

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel Deployment
.vercel/

# TypeScript & Linter
*.tsbuildinfo
next-env.d.ts

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
